# Copy this file to backend/.env and fill in real values.
# This file stores configuration settings used by the FastAPI backend.
# NEVER commit .env to Git because it contains passwords and secret keys.

# --- MySQL ---
# DB_USER: Username used by FastAPI to connect to MySQL.
DB_USER=root

# DB_PASSWORD: Password of the MySQL user.
DB_PASSWORD=root

# DB_HOST: Address of the MySQL server.
# localhost means the same machine when the backend runs directly on your computer.
DB_HOST=localhost

# DB_PORT: Port used by MySQL to accept database connections.
# 3306 is the default MySQL port.
DB_PORT=3306

# DB_NAME: Name of the database used to store student records.
DB_NAME=student_db


# --- Auth ---
# SECRET_KEY: Secret key used to sign and verify JWT tokens.
# It must remain private to prevent attackers from forging tokens.
# Generate a strong random key using:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=28d0f9894cd73429438ef22ca3857da2c8b7f6816c4bc2a71b64e4f85e3df14c

# ACCESS_TOKEN_EXPIRE_MINUTES: Specifies how long an access token remains valid.
# 60 means the token expires after 60 minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ADMIN_INVITE_CODE: Secret code required to register an administrator.
# The backend checks the entered code against this value.
# Leave empty to disable admin registration, if the backend supports this behavior.
ADMIN_INVITE_CODE=12


# --- Cookie / CORS ---
# COOKIE_SECURE: Controls whether authentication cookies are sent only over HTTPS.
# false is generally used for local HTTP development.
# Set to true when deploying over HTTPS.
COOKIE_SECURE=false

# COOKIE_SAMESITE: Controls when the browser sends cookies with cross-site requests.
# lax provides some protection against cross-site request forgery (CSRF).
COOKIE_SAMESITE=lax

# CORS_ORIGINS: Lists frontend origins permitted to make browser requests to the backend.
# These are the default local React/Vite development addresses.
# Separate multiple origins with commas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173